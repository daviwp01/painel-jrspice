APP_NAME=Jrspice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Google Tag Manager. O snippet só entra em produção (APP_ENV=production);
# deixe vazio para desligar o rastreamento sem alterar o código.
GTM_CONTAINER_ID=GTM-5BTMPRFS

# ── Formulário público de cadastro (embed) ──────────────────────────────────
# Origens autorizadas a enviar o formulário (separadas por vírgia).
EMBED_ALLOWED_ORIGINS=https://xvision.xpice.pt
# Sites autorizados a exibir o formulário em iframe. Use uma lista em produção.
EMBED_FRAME_ANCESTORS=https://xvision.xpice.pt,https://*.xpice.pt
# Defesas contra envio automatizado.
EMBED_MIN_FILL_SECONDS=3
EMBED_TOKEN_TTL=86400
EMBED_PER_MINUTE_BY_IP=5
EMBED_PER_DAY_BY_IP=30
EMBED_PER_MINUTE_BY_EMAIL=3
# ── Google reCAPTCHA v3 (invisível) ─────────────────────────────────────────
# Grátis até 10.000 verificações/mês. Enquanto as chaves estiverem vazias a
# verificação fica desligada e o login/cadastro seguem só com os limites.
# v3 = invisível por nota (padrão) | v2 = caixinha "Não sou um robô".
# O tipo precisa ser o mesmo da chave criada no console do Google.
RECAPTCHA_TYPE=v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENABLED=true

# ── Autenticação (login / cadastro / confirmação de senha) ──────────────────
AUTH_LOGIN_PER_MINUTE_BY_IP=10
AUTH_REGISTER_PER_MINUTE_BY_IP=5
AUTH_REGISTER_PER_DAY_BY_IP=20
AUTH_REGISTER_PER_MINUTE_BY_EMAIL=3
AUTH_CONFIRM_PER_MINUTE_BY_IP=10

# Versionamento dos assets minificados (?v=...). Rode `npm run build:embed`
# e cole aqui o hash impresso para invalidar o cache dos navegadores.
EMBED_ASSET_VERSION=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disco privado dos documentos de contrato: "local" ou "s3"
# (use "s3" quando AWS_BUCKET estiver configurado em produção)
CONTRACTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=


# ---------------------------------------------------------------------------
# Track & Trace (multi-carrier container tracking)
# ---------------------------------------------------------------------------
# Backend por armadora: api | aggregator | scraper. Deixe vazio para manter o
# canal desligado (o sistema responde "not_configured" em vez de inventar dado).
TRACKING_DEFAULT_BACKEND=api
TRACKING_DEFAULT_CARRIER=maersk
TRACKING_CACHE_TTL=60
TRACKING_HTTP_TIMEOUT=15

# Agregador pago usado quando a armadora não tem API própria configurada
TRACKING_AGGREGATOR_URL=
TRACKING_AGGREGATOR_KEY=

# Endpoint + credencial oficial de cada armadora
TRACKING_MAERSK_BACKEND=
TRACKING_MAERSK_URL=
TRACKING_MAERSK_KEY=

TRACKING_CMACGM_BACKEND=
TRACKING_CMACGM_URL=
TRACKING_CMACGM_KEY=

TRACKING_HAPAG_BACKEND=
TRACKING_HAPAG_URL=
TRACKING_HAPAG_KEY=

TRACKING_MSC_BACKEND=
TRACKING_MSC_URL=
TRACKING_MSC_KEY=

TRACKING_EVERGREEN_BACKEND=
TRACKING_EVERGREEN_URL=

TRACKING_HMM_BACKEND=
TRACKING_HMM_URL=

TRACKING_OOCL_BACKEND=
TRACKING_OOCL_URL=

TRACKING_COSCO_BACKEND=
TRACKING_COSCO_URL=

TRACKING_ZIM_BACKEND=
TRACKING_ZIM_URL=
